// Prisma 6.x — see the "Prisma version conventions" guardrail in CLAUDE.md.
// Do NOT add an `output` field, a driver adapter, or a prisma.config.ts.

generator client {
  provider = "prisma-client-js"

  // ⚠️ `previewFeatures = ["relationJoins"]` was tried on 2026-08-19 and REMOVED
  // because it changed nothing. Measured, same query, same data:
  //
  //     default strategy        246 ms   1 query
  //     relationLoadStrategy    237 ms   1 query
  //
  // Prisma 6 already collapses a nested `select` with relations into ONE
  // statement using JSON aggregation (you can see `"Product_units"."__prisma_data__"`
  // in the query log). The four-queries-per-product fan-out that motivated it
  // comes from `include`, which this codebase does not use on hot paths — every
  // sale/product read goes through an explicit `select`.
  //
  // Do not re-enable it hoping for a speed-up. If a future query does fan out,
  // the first move is to convert its `include` to a `select`.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supavisor SESSION mode, :5432 (see CLAUDE.md)
  directUrl = env("DIRECT_URL") // session mode too; migrations only
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id            String        @id @default(cuid())
  name          String // "Beverages" | "Bakery" | "Milk Shop"
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String // e.g. "Pepsi", "Cake Rusk", "Juices"
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

model Product {
  id            String      @id @default(cuid())
  name          String // e.g. "Pepsi 1.5L", "Premium Cake Rusk"
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  price         Decimal     @db.Decimal(10, 2)
  size          String? // "half_litre" | "1L" | "1.5L" | "2.25L" | "large" | "small" | null
  qualityTier   String? // "premium" | "simple" | null
  shape         String? // "circle" | "rectangular_round" | null (russ)
  unit          String? // "cotton" (eggs) | "piece" | "bottle" | null
  /// Per-unit COOLING CHARGE, set by the owner in the catalog (Migration E).
  ///
  /// NULL means this product is never chilled — bakery, milk — and the till
  /// shows NO toggle for it. That is deliberately different from 0, which would
  /// mean "chilled, at no charge" and WOULD show a toggle. Buns must not offer
  /// one.
  ///
  /// Per PRODUCT, not per category: a 1.5L and a 2.25L do not carry the same
  /// charge, so one global rate would be wrong for every size but one.
  ///
  /// The BILL never sets the amount — it carries a toggle and the server reads
  /// this column. One place the number lives.
  coolingCharge Decimal?    @db.Decimal(10, 2)
  /// Units on hand. TEMPORARY seed value of 100 — the owner sets real numbers
  /// via the catalog stock editor.
  ///
  /// DECIMAL, not Int (Migration D, 2026-08-12). Milk is sold in fractional
  /// litres — 12.5 L is an ordinary sale — and an integer column cannot be
  /// decremented by it. Countable goods (bottles, cottons, buns) simply carry a
  /// .00 scale. The same widening `SaleItem.quantity` took in Migration C.
  ///
  /// NOTE the code contract: `SaleProduct.stock` in `lib/sales.ts` is
  /// deliberately still a plain `number`, normalised at the `loadSaleProducts`
  /// boundary. Stock is a COUNT, not money — it is only ever compared and
  /// summed, and the authoritative arithmetic happens in Postgres via
  /// `applyStockDeltas`' conditional increment. Do not widen it to Decimal
  /// through the app layer without reading that function first.
  stock         Decimal     @default(100) @db.Decimal(10, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// The SELLING UNITS this product can be sold in (Migration F, S8).
  ///
  /// Empty = sold in whatever `stock` counts, one at a time — which is every
  /// product today. Eggs get dozen/tray/peti; a beverage size gets bottle/pet.
  units ProductUnit[]

  // REQUIRED back-relation (do not remove, migration fails without it).
  // There were three until Migration B; the per-module item tables are gone.
  saleItems SaleItem[]
}

// ---------------------------------------------------------------------------
/// A way to SELL a product, on top of the base unit its stock is counted in.
///
/// ---------------------------------------------------------------------------
/// ONE STOCK POOL, SEVERAL SELLING UNITS (S8, the owner's #19)
/// ---------------------------------------------------------------------------
/// `Product.stock` counts BASE units — single eggs, single bottles, litres.
/// A unit says how many base units one of it contains, so selling a peti of eggs
/// decrements the SAME pool by 360 and a dozen decrements it by 12. That is the
/// whole feature: the loose-egg count can never disagree with the tray count,
/// because there is only one count.
///
/// ⚠️ A TABLE, NOT MORE PRODUCTS. Three egg rows sharing a stock pointer is the
/// discount-variant model this project already deleted once (36 products, see
/// "Discounts, russ, eggs" in CLAUDE.md) and it fails the same way: rows that
/// drift in price, name and active state while claiming to be one thing.
model ProductUnit {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// What the owner calls it: "dozen" | "tray" | "peti" | "bottle" | "pet".
  ///
  /// A product may hold TWO pets with different counts — Gourmet 1.5L ships both
  /// 4 and 6 — so the name carries the count ("pet 4", "pet 6") and the unique
  /// index below is on the NAME, not on some notion of a single pet.
  name       String
  /// How many BASE units one of these contains. 12 · 30 · 360 · 24 · 6 · 4.
  /// DECIMAL so a future half-unit is expressible without another migration.
  baseFactor Decimal  @db.Decimal(10, 2)
  /// The price of ONE of these. A peti is NOT 30 x the dozen price — that is why
  /// each unit carries its own price rather than deriving from the product's.
  price      Decimal  @db.Decimal(10, 2)
  /// Pre-selected on the till. At most one per product.
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, name])
  @@index([productId])
}

// Customers (shared across all sales) + Receivables
// ---------------------------------------------------------------------------

model Customer {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  type      String // "hotel" | "individual" | "shop"
  isActive  Boolean           @default(true)
  sales     Sale[]
  payments  CustomerPayment[]
  createdAt DateTime          @default(now())
}

// Tracks money the customer has PAID. Outstanding balance is computed:
// (sum of all their sales) - (sum of their payments).
model CustomerPayment {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  paymentDate DateTime @default(now())
  amount      Decimal  @db.Decimal(10, 2)
  method      String? // "cash" | "transfer" | null
  notes       String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// ⚠️ BeverageSale / BeverageSaleItem / BakerySale / BakerySaleItem WERE HERE.
//
// Dropped by Migration B (S9). Every bill they held had already been copied
// into `Sale` / `SaleItem` keeping its id, so nothing was lost — that copy is
// what made the drop safe, and it is why the app carried a de-duplication
// filter for as long as both existed.
//
// Do not recreate them. A per-module sale table is the model the unified rework
// existed to replace: it cannot represent one bill that draws from two shops,
// which is what the owner actually sells.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Sales — ONE table for beverages AND bakery
// ---------------------------------------------------------------------------
// A bill can hold beverage, bakery AND milk lines together; the client orders
// across categories routinely.
//
// Milk belongs here too (decided 2026-08-12). It was previously carved out on
// the grounds that it "has no products and no stock" — that no longer holds:
// milk becomes a real Product, and `SaleItem.quantity` (Migration C) and
// `Product.stock` (Migration D) are both Decimal precisely so a fractional-litre
// line is an ordinary line on this table. `MilkSale` still exists and is still
// the live table until the unified switch-over ships; nothing is dropped before
// then.
//
// Replaces BeverageSale/BakerySale, which encoded the module in the TABLE. That
// made per-module revenue a sale-level SUM, which cannot survive a mixed bill.
// The module now lives on the LINE (see SaleItem.moduleKey).

model Sale {
  id              String     @id @default(cuid())
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  saleDate        DateTime   @default(now())
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  totalAmount     Decimal    @db.Decimal(10, 2)
  notes           String?
  items           SaleItem[]
  createdAt       DateTime   @default(now())

  @@index([customerId, saleDate])
  @@index([saleDate])
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  /// "beverages" | "bakery" | "milk" — a SNAPSHOT of what this line was sold as.
  ///
  /// NOT derived from the product’s category at report time. The catalog lets
  /// the owner move a product between sub-categories, and deriving would then
  /// silently re-attribute closed months between modules. A line’s module is
  /// the same kind of fact as its unitPrice: what it was sold as, fixed at the
  /// moment of sale.
  ///
  /// "milk" was added for the unified checkout (Migration C, 2026-08-11). It is
  /// a bare String with no CHECK constraint and no enum, so the new value needs
  /// no schema change — and nothing reads this column yet.
  moduleKey       String
  /// DECIMAL, not Int: milk sells in LITRES and 2.5 L is a real quantity.
  /// Widened in Migration C. Beverages and bakery still use whole units; the
  /// decimal simply does not get in their way.
  quantity        Decimal @db.Decimal(10, 2)
  unitPrice       Decimal @db.Decimal(10, 2)
  /// The SELLING UNIT this line was sold in, snapshotted (Migration F).
  ///
  /// NULL = sold in the base unit, which is every line written before S8. Kept
  /// as a NAME rather than a foreign key on purpose: deleting or renaming a unit
  /// in the catalog must not change what a printed bill says it sold, and a bill
  /// that reads "2 peti" must keep reading that forever.
  unitName        String?
  /// Base units per selling unit, snapshotted with the name. 1 = base unit.
  ///
  /// 🔒 THIS IS WHAT STOCK MOVED BY: `quantity x unitFactor`. Storing it means a
  /// later change to the catalog's peti size cannot retroactively alter how much
  /// stock a past sale consumed — the same rule as `unitPrice` and `coolingRate`.
  unitFactor      Decimal @default(1) @db.Decimal(10, 2)
  /// The cooling rate ACTUALLY CHARGED on this line, per unit (Migration E).
  ///
  /// Snapshotted exactly like `unitPrice`, and for the same reason: editing the
  /// catalog's charge later must never move a bill that has already been
  /// printed. 0 = not chilled, which is also every line written before this
  /// column existed.
  coolingRate     Decimal @default(0) @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(10, 2)
  /// This line’s share of the bill AFTER the whole-bill discount.
  ///
  /// PER-MODULE REVENUE IS SUM(netLineTotal), NEVER SUM(lineTotal). Line totals
  /// add up to the SUBTOTAL, so summing them per module would overstate revenue
  /// on every bill-discounted sale and break the dashboard’s claim that
  /// beverages + bakery + milk equals total revenue. Apportioned pro-rata by
  /// lineTotal, 2dp, residue to the largest line so the parts sum to
  /// totalAmount exactly. Allocation lives beside the discount maths in
  /// lib/sales.ts — one implementation.
  netLineTotal    Decimal @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
  @@index([moduleKey])
}

// ---------------------------------------------------------------------------
// Milk Shop
// ---------------------------------------------------------------------------

model Farmer {
  id         String           @id @default(cuid())
  name       String
  phone      String?
  address    String?
  isActive   Boolean          @default(true)
  deliveries MilkDelivery[]
  purchases  FarmerPurchase[]
  createdAt  DateTime         @default(now())
}

model MilkDelivery {
  id            String   @id @default(cuid())
  farmerId      String
  farmer        Farmer   @relation(fields: [farmerId], references: [id])
  deliveryDate  DateTime
  morningLiters Decimal? @db.Decimal(8, 2) // null if no morning delivery
  eveningLiters Decimal? @db.Decimal(8, 2) // null if no evening delivery
  ratePerLiter  Decimal  @db.Decimal(8, 2)
  totalLiters   Decimal  @db.Decimal(8, 2) // computed: (morning ?? 0) + (evening ?? 0)
  totalAmount   Decimal  @db.Decimal(10, 2) // computed: totalLiters * ratePerLiter
  notes         String?
  createdAt     DateTime @default(now())

  @@index([farmerId, deliveryDate])
}

model FarmerPurchase {
  id              String   @id @default(cuid())
  farmerId        String
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  purchaseDate    DateTime @default(now())
  itemDescription String // "Cow food" | "Milk" | "Yogurt" | "Tea powder" | custom
  amount          Decimal  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([farmerId, purchaseDate])
}

// ⚠️ MilkSale WAS HERE. Dropped by Migration B (S9), with the owner's approval.
//
// Milk SOLD is a `Sale` with a milk line — `prod_milk`, quantity in litres —
// which is what the S4.3 cutover made true and what every figure has read since.
// Keeping the old table would have meant the same sale living in two places
// forever and a de-duplication filter that could never be removed.
//
// The FARMER side is untouched and is a different thing entirely: MilkDelivery
// and FarmerPurchase are milk BOUGHT, they have no customer and no product, and
// they are above.

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

/// Owner-editable app settings. EXACTLY ONE ROW, id = "app".
///
/// The home for anything the owner must be able to change without a redeploy —
/// starting with the receipt header. Not a config file, deliberately: a typo in
/// the shop name should be a 5-second edit on his phone, not a code change and a
/// deploy he has to ask someone else for.
///
/// The singleton is enforced by a CHECK constraint in the migration, not just by
/// this default, so a stray create() cannot give the app a second row for the
/// receipt to disagree with.
model Settings {
  id String @id @default("app")

  /// NOT NULL: a receipt always has a name line, so there is always something to
  /// print and no call site needs a fallback. Seeded with a jarring placeholder
  /// rather than a plausible one — see configuredAt.
  shopName    String
  /// Nullable, because "the shop has no phone" is a legitimate final state and
  /// the receipt should omit the line rather than print an empty one.
  shopPhone   String?
  shopAddress String?

  /// NULL until the owner saves his real details for the first time.
  ///
  /// This is the go-live check (PRE-HANDOFF CHECKLIST #2b) and the source of the
  /// in-app placeholder banner. It records the FACT of configuration rather than
  /// string-matching the seeded placeholder text, which would silently stop
  /// detecting anything the day someone edits that wording — reporting
  /// "configured" for a shop that is not.
  configuredAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// User (auth)
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String // bcrypt hash
  createdAt DateTime @default(now())
}
