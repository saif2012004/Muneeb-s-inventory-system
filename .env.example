# Copy to .env and fill in. Never commit the filled-in .env.

# Supabase POOLED connection (port 6543) - app runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase DIRECT connection (port 5432) - `prisma migrate` only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# Random 32+ char string. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""

# http://localhost:3000 in dev, the production URL on Vercel.
NEXTAUTH_URL="http://localhost:3000"
