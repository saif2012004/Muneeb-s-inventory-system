# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Broad on purpose: .env, .env.local, .env.production, and the .env.local the
# Vercel CLI writes (VERCEL_OIDC_TOKEN) are all secrets. The negation must stay
# LAST in this block — a later .env* rule would silently re-ignore the example.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
# The docs/ folder was removed on 2026-08-19, once the build it documented was
# finished; every file remains in git history. This entry is kept so that a
# prompt scratch file recreated at that path is still ignored rather than
# accidentally committed.
docs/prompt.txt

# database backups — NEVER commit a dump. Root-anchored so prisma/migrations/*.sql
# (which ARE the schema history and must stay tracked) are unaffected.
/*.sql
/*.dump
/*.backup
/backups/

# Supabase CLI scratch. Holds the project ref and the pooler URL — local state,
# not source.
supabase/.temp/
